{
  "name": "clinical-bpmn",
  "private": true,
  "description": "Semantic clinical annotations and FHIR mapping for BPMN process models",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forschungsgruppe-digital-health/bpmn-js-clinical-semantics.git"
  },
  "homepage": "https://github.com/forschungsgruppe-digital-health/bpmn-js-clinical-semantics#readme",
  "bugs": {
    "url": "https://github.com/forschungsgruppe-digital-health/bpmn-js-clinical-semantics/issues"
  },
  "scripts": {
    "dev": "npm run --workspace=examples/vanilla dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "workspaces": [
    "packages/terminology",
    "packages/fhir-mapping",
    "packages/vue",
    "examples/*"
  ],
  "devDependencies": {
    "@types/fhir": "^0.0.41",
    "vitest": "^3.1.1"
  },
