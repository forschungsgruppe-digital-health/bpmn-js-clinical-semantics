                {
                  "system": "http://snomed.info/sct",
                  "code": "47625008",
                  "display": "Intravenous route (qualifier value)"
                }
              ]
            }
          }
        ]
      },
      "request": {
        "method": "PUT",
        "url": "ActivityDefinition/activitydefinition-chemo"
      }
