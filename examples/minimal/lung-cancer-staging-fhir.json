        "version": "0.1.0",
        "name": "TNMStagingAssessment",
        "title": "TNM-Staging durchführen",
        "status": "draft",
        "experimental": true,
        "date": "2026-04-20",
        "description": "Perform TNM clinical staging using imaging (CT, PET-CT), pathology, and clinical findings. Produces an Observation with the TNM stage.",
        "purpose": "Maps to BPMN element Task_Staging. Produces a staging Observation used by the treatment decision gateway.",
        "kind": "ServiceRequest",
        "code": {
          "coding": [
            {
              "system": "http://snomed.info/sct",
              "code": "254292007",
              "display": "Tumor staging (tumor staging)"
            },
            {
              "system": "http://loinc.org",
              "code": "21908-9",
              "display": "Stage group.clinical Cancer"
            }
          ],
          "text": "TNM-Staging"
        },
        "observationResultRequirement": [
          {
            "reference": "urn:uuid:observationdefinition-tnm-stage"
          }
        ]
      },
      "request": {
        "method": "PUT",
        "url": "ActivityDefinition/activitydefinition-tnm-staging"
      }
    },

