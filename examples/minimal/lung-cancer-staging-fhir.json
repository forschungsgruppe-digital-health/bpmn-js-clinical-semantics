        "title": "Systemische Chemotherapie",
        "status": "draft",
        "experimental": true,
        "date": "2026-04-20",
        "description": "Platinum-based doublet chemotherapy for inoperable advanced lung cancer (Stadium III–IV). Produces a MedicationRequest resource.",
        "purpose": "Maps to BPMN element Task_Chemo. Executed when TNM staging indicates inoperable disease (Stage III or IV).",
        "kind": "MedicationRequest",
        "intent": "order",
        "productCodeableConcept": {
          "coding": [
            {
              "system": "http://www.whocc.no/atc",
              "code": "L01XA01",
              "display": "Cisplatin"
            },
            {
              "system": "http://snomed.info/sct",
              "code": "387318005",
              "display": "Cisplatin (substance)"
            }
          ],
          "text": "Cisplatin-basierte Chemotherapie"
        },
        "dosage": [
          {
            "text": "75 mg/m² IV Day 1, q21d",
            "timing": {
              "repeat": {
