  },
  "entry": [
    {
      "fullUrl": "urn:uuid:plandefinition-lung-ca-staging",
      "resource": {
        "resourceType": "PlanDefinition",
        "id": "plandefinition-lung-ca-staging",
        "meta": {
          "profile": [
            "http://hl7.org/fhir/StructureDefinition/PlanDefinition"
          ]
        },
        "url": "https://clinical-bpmn.org/examples/PlanDefinition/lung-cancer-staging",
        "version": "0.1.0",
        "name": "LungCancerStagingPathway",
        "title": "Lungenkarzinom Therapieentscheidung",
        "status": "draft",
        "experimental": true,
        "date": "2026-04-20",
        "publisher": "Forschungsgruppe Digital Health",
        "description": "Minimal example: lung cancer treatment decision pathway based on TNM staging. Maps to the BPMN process Process_LungCaMin in lung-cancer-staging.bpmn.",
        "purpose": "Demonstrate the mapping between BPMN process elements and FHIR R4 PlanDefinition actions. Used for onboarding developers to bpmn-js-clinical-semantics.",
        "type": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/plan-definition-type",
              "code": "clinical-protocol",
              "display": "Clinical Protocol"
            }
          ]
        },
        "subjectCodeableConcept": {
          "coding": [
            {
              "system": "http://hl7.org/fhir/resource-types",
              "code": "Patient"
            }
          ]
        },
        "topic": [
          {
            "coding": [
              {
                "system": "http://snomed.info/sct",
                "code": "363358000",
                "display": "Malignant tumor of lung (disorder)"
              }
            ],
            "text": "Lungenkarzinom"
          }
        ],
        "action": [
          {
            "_comment": "Corresponds to BPMN: Task_Staging",
            "id": "action-staging",
            "title": "TNM-Staging durchführen",
            "description": "Perform TNM staging assessment to determine tumor stage and guide treatment decision.",
            "code": [
              {
                "coding": [
                  {
                    "system": "http://snomed.info/sct",
                    "code": "254292007",
                    "display": "Tumor staging (tumor staging)"
                  }
                ]
              }
            ],
            "definitionCanonical": "urn:uuid:activitydefinition-tnm-staging",
            "input": [
              {
                "_comment": "Corresponds to BPMN: DataObj_MRI (DataInputAssociation on Task_Staging)",
                "type": "DocumentReference",
                "profile": [
                  "http://hl7.org/fhir/StructureDefinition/DocumentReference"
                ]
              }
            ],
            "output": [
              {
                "type": "Observation",
                "profile": [
                  "http://hl7.org/fhir/StructureDefinition/Observation"
                ]
              }
            ],
            "documentation": [
              {
                "type": "depends-on",
                "resource": "urn:uuid:documentreference-mri-report"
              }
            ]
          },
          {
            "_comment": "Corresponds to BPMN: Gateway_Split — modelled as a group with exclusive selection behavior",
            "id": "action-treatment-decision",
            "title": "Therapieentscheidung nach Tumorstadium",
            "description": "Exclusive decision based on TNM stage: early (I–II) → surgery, advanced (III–IV) → chemotherapy.",
            "groupingBehavior": "visual-group",
            "selectionBehavior": "exactly-one",
            "action": [
              {
                "_comment": "Corresponds to BPMN: Task_Surgery (path A: Stadium I–II)",
                "id": "action-surgery",
                "title": "Chirurgische Resektion",
                "description": "Lobectomy or pneumonectomy for operable early-stage (I–II) lung cancer.",
                "condition": [
                  {
                    "kind": "applicability",
                    "expression": {
                      "language": "text/fhirpath",
                      "expression": "%staging.valueCodeableConcept.coding.where(system='http://snomed.info/sct' and code.startsWith('258215001')).exists() or %staging.valueCodeableConcept.coding.where(system='urn:oid:2.16.840.1.113883.15.16' and code.matches('^(I|II)[^I]?')).exists()",
                      "description": "TNM Stage I or II — operable"
                    }
                  }
                ],
                "code": [
                  {
                    "coding": [
                      {
                        "system": "http://snomed.info/sct",
                        "code": "359615001",
                        "display": "Partial lobectomy of lung (procedure)"
                      }
                    ]
                  }
                ],
                "definitionCanonical": "urn:uuid:activitydefinition-surgery"
              },
              {
                "_comment": "Corresponds to BPMN: Task_Chemo (path B: Stadium III–IV)",
                "id": "action-chemo",
                "title": "Systemische Chemotherapie",
                "description": "Platinum-based doublet chemotherapy for inoperable advanced (III–IV) lung cancer.",
                "condition": [
                  {
                    "kind": "applicability",
                    "expression": {
                      "language": "text/fhirpath",
                      "expression": "%staging.valueCodeableConcept.coding.where(system='urn:oid:2.16.840.1.113883.15.16' and code.matches('^(III|IV)')).exists()",
                      "description": "TNM Stage III or IV — inoperable"
                    }
                  }
                ],
                "code": [
                  {
                    "coding": [
                      {
                        "system": "http://snomed.info/sct",
                        "code": "367336001",
                        "display": "Chemotherapy (procedure)"
                      }
                    ]
                  }
                ],
                "definitionCanonical": "urn:uuid:activitydefinition-chemo"
              }
            ]
          },
          {
            "_comment": "Corresponds to BPMN: Task_Followup (after gateway join)",
            "id": "action-followup",
            "title": "Nachsorge-Assessment",
            "description": "Post-treatment follow-up care plan including imaging surveillance and lab monitoring.",
            "code": [
              {
                "coding": [
                  {
                    "system": "http://snomed.info/sct",
                    "code": "390906007",
                    "display": "Follow-up encounter (procedure)"
                  }
                ]
              }
            ],
            "definitionCanonical": "urn:uuid:activitydefinition-followup",
            "output": [
              {
                "_comment": "Corresponds to BPMN: DataObj_DischargeLetter (DataOutputAssociation on Task_Followup)",
                "type": "DocumentReference",
                "profile": [
                  "http://hl7.org/fhir/StructureDefinition/DocumentReference"
                ]
              }
            ],
            "relatedAction": [
              {
                "actionId": "action-treatment-decision",
                "relationship": "after-end"
              }
            ]
          }
        ]
      },
      "request": {
        "method": "PUT",
        "url": "PlanDefinition/plandefinition-lung-ca-staging"
      }
    },

    {
